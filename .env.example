# Server
PORT=8080
NODE_ENV=development
API_PREFIX=api/v1

# MongoDB (connect locally with: mongosh "mongodb://127.0.0.1:27017/todo_db")
MONGODB_URI=mongodb://127.0.0.1:27017/todo_db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# CORS 
CORS_ORIGIN=*

# Throttling (requests per ttl window, ttl in ms)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
